# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Required for AI email rewriting and inbox classification.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── App URL ──────────────────────────────────────────────────────────────────
APP_URL="MY_APP_URL"

# ─── Firebase (Backend & Auth) ────────────────────────────────────────────────
# Get these from: https://console.firebase.google.com
# → Tu proyecto → Configuración del proyecto → Tus apps → SDK de configuración
# Without these, the app runs in Demo Mode (localStorage only, no auth required).
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# ─── Google Maps (Lead Search) ────────────────────────────────────────────────
# Required for local business search via Google Places API.
VITE_GOOGLE_MAPS_API_KEY=""
