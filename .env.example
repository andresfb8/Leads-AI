# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Required for AI email rewriting and inbox classification.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── App URL ──────────────────────────────────────────────────────────────────
APP_URL="MY_APP_URL"

# ─── Supabase (Backend & Auth) ────────────────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
# Without these, the app runs in Demo Mode (localStorage only, no auth required).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# ─── Google Maps (Lead Search) ────────────────────────────────────────────────
# Required for local business search via Google Places API.
VITE_GOOGLE_MAPS_API_KEY=""
